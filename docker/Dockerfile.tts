# silero_slim: только синтез, без обучения. Собирается от корня репозитория:
#
#   docker build -t silero_slim -f docker/Dockerfile.tts .
#
# Боевой образ silero_ru весит 11.9 ГБ — там CUDA, f5_tts, librosa, всё для
# обучения. Пути синтеза из этого нужны четыре пакета: torch, torchaudio,
# numpy, silero-stress. Отсюда ~2 ГБ вместо двенадцати.
#
# omegaconf тут не случайно: hubconf silero-models читает им models.yml,
# и без него load() падает ModuleNotFoundError на первом же запуске.
#
# torchaudio не роскошь: Home Assistant просит 22050 Гц, модель отдаёт 48000,
# и на каждый запрос wyoming зовётся resample() (voice/audio.py). Без него
# HTTP-путь работал бы, а HA падал бы с ImportError — проверка «curl /say»
# такую сборку пропустила бы.
#
# Версии torch прибиты: на 2.5.1 голос проверен, а jit-пакет Silero к версии
# чувствителен, и молча разъехаться ему тут негде.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    SILERO_THREADS=8

RUN pip install --index-url https://download.pytorch.org/whl/cpu \
      torch==2.5.1 torchaudio==2.5.1 \
 && pip install numpy omegaconf "silero-stress"

# libgomp1 — только ради aarch64: там libtorchaudio.so слинкован с системным
# libgomp.so.1, а в slim его нет (у torch свой, но переименованный в
# torch.libs/libgomp-*.so, и его видит только torch). На x86_64 зависимости
# нет, там всё работало без пакета. На aarch64 падает первый же import
# torchaudio — то есть lufs() при --loudness и ресемпл под wyoming, а
# «curl /say» на 48 кГц — нет: проверка HTTP такую сборку пропускает.
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
 && rm -rf /var/lib/apt/lists/*

# onnxruntime — для int8-вокодера (voice/vocoder_ort.py + vocoder_dyn.onnx):
# колесо 6 МБ, сессия в живом процессе +10 МБ RSS, синтез ~1.7x быстрее джита
# при CER 0.000. Отдельным слоем после apt — чтобы правки кода не перекачивали
# torch: кэш слоёв идёт сверху вниз, а этот RUN дешевле того, что выше.
RUN pip install onnxruntime

WORKDIR /app
COPY voice/ /app/voice/
COPY service/ /app/service/
# голоса запекаем внутрь: на целевом сервере репозитория рядом не будет, и
# монтировать нечего (в service/compose.yml код и веса приходят с хоста).
# Имена каталогов не случайны: из них сервис берёт подписи голосов для Home
# Assistant. Их два, и оба в списке ассистента — переключение там же.
# Каждый файл это 92 МБ образа и +0.2 ГБ RAM у процесса.
COPY voices/artur/model_voice.pt /opt/voices/artur/model_voice.pt
COPY voices/stalker/model_voice.pt /opt/voices/stalker/model_voice.pt
# int8-спины вокодеров (динамическое квантование MatMul, проект silero-int8:
# probe-скрипты и подбор конфигурации — в tvbox-репозитории операций).
# У stalker первый MatMul остаётся fp32: он один видит сырой мел, и его
# u8-квантование съедает разборчивость коротких фраз (детали — README проекта).
COPY voices/artur/vocoder_dyn.onnx /opt/voices/artur/vocoder_dyn.onnx
COPY voices/stalker/vocoder_dyn.onnx /opt/voices/stalker/vocoder_dyn.onnx

# хаб-кэш Silero нужен даже с готовыми весами: load() всегда идёт в
# torch.hub за пакетом v5_5_ru (символы алфавита, список голосов, сам jit).
# Заодно это проверка сборки: не хватит пакета — упадёт здесь, а не в бою.
# silero-stress ничего не качает, модели лежат в самом пакете (65 МБ).
RUN python -c "from voice.model import load; load()" \
 && python -c "from voice.text import Stress; print(Stress()('Проверка сборки'))"

EXPOSE 10500 10501
CMD ["python", "-m", "service.tts", \
     "--model", "/opt/voices/artur/model_voice.pt", \
     "--model", "/opt/voices/stalker/model_voice.pt"]
